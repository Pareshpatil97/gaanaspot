# ===================================
# GaanaSpot Environment Variables
# ===================================
# Copy this file to server/.env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB (REQUIRED)
# Local: mongodb://localhost:27017/gaanaspot
# Atlas: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/gaanaspot
MONGODB_URI=mongodb://localhost:27017/gaanaspot

# JWT Secret (change this to any random string)
JWT_SECRET=my-super-secret-key-change-this

# Client URL (for CORS - only needed in development)
CLIENT_URL=http://localhost:5173
